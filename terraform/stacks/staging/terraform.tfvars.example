# Credentials are loaded from .secrets/staging, never from this file.
domain = "balebase.com"

d1_database_name = "balebase-db-staging"
r2_bucket_name    = "balebase-objects-staging"
inbound_email_subdomain = "inbox-staging.balebase.com"
inbound_email_address   = "upload@inbox-staging.balebase.com"

# The staging deploy script creates all three Workers before Terraform
# attaches these domains.
enable_custom_domains = true

website_hostname = "website-staging.balebase.com"
client_hostname  = "app-staging.balebase.com"
api_hostname     = "api-staging.balebase.com"
