# Credentials are loaded from .secrets/prod, never from this file.
domain = "balebase.com"

d1_database_name = "balebase-db"
r2_bucket_name    = "balebase-objects"
inbound_email_subdomain = "inbox.balebase.com"
inbound_email_address   = "upload@inbox.balebase.com"

# The production deploy script creates all three Workers before Terraform
# attaches these domains.
enable_custom_domains = true

website_hostname = "balebase.com"
client_hostname  = "app.balebase.com"
api_hostname     = "api.balebase.com"
