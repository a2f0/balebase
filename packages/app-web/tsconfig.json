{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@types/bun", "vite/client"]
  },
  "include": [
    "../app/src/env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "browser/**/*.ts",
    "browser/**/*.tsx",
    "searchIndexing.test.ts",
    "screenshots/**/*.ts",
    "playwright.screenshots.config.ts",
    "vite.config.ts",
    "offlineShell.ts"
  ]
}
