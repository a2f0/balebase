{
  "name": "@tearleads/api",
  "version": "0.1.25",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "check": "bunx --bun --no-install tsc --noEmit",
    "db:migrate:local": "bunx --bun --no-install wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bunx --bun --no-install wrangler d1 migrations apply DB --remote",
    "deploy": "bunx --bun --no-install wrangler deploy",
    "dev": "bash ../../scripts/devApi.sh",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/core": "1.7.0",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.0",
    "hono": "4.13.13",
    "pdf-lib": "1.17.1",
    "postal-mime": "3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@types/bun": "1.4.2",
    "miniflare": "5.20260811.1-alpha"
  }
}
