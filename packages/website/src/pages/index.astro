---
import { plans, productName } from "@balebase/ui/brand";
import type { IconName } from "@balebase/ui/icons";
import BusinessPreview from "../components/BusinessPreview.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { appUrl } from "../site";
import "../styles/home.css";

// Keep pricing copy tied to the plans shared with the billing page.
const [free, pro] = plans;

const features: {
  icon: IconName;
  text: string;
  title: string;
  example: string;
}[] = [
  {
    icon: "finance",
    title: "Know where the money goes",
    text: "Connect bank accounts through Plaid and import transactions. Categorize expenses, add notes and labels, and see spending totals by category.",
    example: "Review a supplier payment and link the receipt from your inbox.",
  },
  {
    icon: "contract",
    title: "Get contracts signed",
    text: "Upload a PDF, place signature fields, and send it to your signers. Reuse contract templates, set reminders, and download the signed copy.",
    example: "Send a service agreement and see who still needs to sign.",
  },
  {
    icon: "organization",
    title: "Keep employee paperwork moving",
    text: "Assign forms with due dates and review submitted documents. Each person has a My documents page to see and complete their requests.",
    example: "Request a new hire’s forms and track what has been submitted.",
  },
  {
    icon: "inbox",
    title: "Put business documents in reach",
    text: "Organize uploaded files in folders. Forward email and attachments to your organization’s inbox, then link messages to equipment, folders, or transactions.",
    example: "Keep a laptop’s purchase email linked to its equipment record.",
  },
  {
    icon: "equipment",
    title: "Track the equipment you hand out",
    text: "Record computers, phones, and monitors with their make, model, serial number, and purchase date. Assign each item to a member of your team.",
    example:
      "Look up which laptop a teammate has before ordering a replacement.",
  },
  {
    icon: "issues",
    title: "Give follow-up work an owner",
    text: "Create issues with a priority and assignee. Track standalone issues alongside those raised from transactions and audits, through to resolution.",
    example:
      "Assign an unexpected charge to the person who can investigate it.",
  },
];

const steps: { icon: IconName; text: string; title: string }[] = [
  {
    icon: "finance",
    title: "Review the spending",
    text: "Import your latest bank transactions, categorize expenses, and mark reviewed items. Raise an issue on a transaction that needs another look.",
  },
  {
    icon: "signature",
    title: "Move the paperwork along",
    text: "Check which contracts are waiting for signatures and send a reminder. Review employee forms as people submit them.",
  },
  {
    icon: "audits",
    title: "Check the work on site",
    text: "Run an audit from a reusable checklist. Record answers, attach photos to issues, and assign the fixes to your team.",
  },
];

const essentials: { icon: IconName; text: string; title: string }[] = [
  {
    icon: "businesses",
    title: "Business records",
    text: "Keep legal names, EINs, incorporation dates, and addresses for the businesses you run.",
  },
  {
    icon: "security",
    title: "Team access",
    text: "Manage owners, admins, and members. Control Finance access with groups and require two-factor authentication for members.",
  },
  {
    icon: "audits",
    title: "Audits and activity history",
    text: "Build reusable checklists and track answers, issues, and changes. Each audit keeps the template version it started with.",
  },
];
---

<BaseLayout
  description={`${productName} is small business management software for expenses, contracts, employee forms, documents, equipment, and audits. Start free and add your team as you grow.`}
  title={`${productName} — Small business management software`}
>
  <section aria-labelledby="hero-title" class="hero">
    <div class="container heroInner">
      <div class="heroCopy">
        <p class="eyebrow eyebrowDot">Small business management software</p>
        <h1 class="headline heroTitle" id="hero-title">
          Run the business. <span class="serifAccent">Keep it together.</span>
        </h1>
        <p class="lead heroLead">
          Manage expenses, contracts, employee paperwork, and equipment in one
          workspace. {productName} brings the daily admin together so you and your
          team can keep work moving.
        </p>
        <div class="cluster heroActions">
          <a class="button buttonPrimary buttonLg" href={appUrl}>
            Start free <Icon name="arrowRight" />
          </a>
          <a class="button buttonLg" href="#product">Explore the features</a>
        </div>
        <p class="heroNote">
          No credit card required. {free.name} for {free.features[0]}.
          {" "}{pro.name} is {pro.price} {pro.cadence}.
        </p>
      </div>
      <BusinessPreview />
    </div>
  </section>

  <section aria-labelledby="product-title" class="band" id="product">
    <div class="container">
      <div class="bandIntro">
        <p class="eyebrow eyebrowDot">The tools to run your business</p>
        <h2 class="title" id="product-title">
          From the bank statement{" "}
          <span class="serifAccent titleBreak">to the signed agreement.</span>
        </h2>
        <p class="lead">
          For owners and small teams handling the money, the people, and the
          paperwork themselves. Find the record, see its status, and take the
          next step.
        </p>
      </div>
      <div class="featureGrid">
        {
          features.map((feature) => (
            <article class="card featureCard">
              <div class="featureHead">
                <span class="featureIcon"><Icon name={feature.icon} size={20} /></span>
                <h3 class="featureTitle">{feature.title}</h3>
              </div>
              <p class="featureText">{feature.text}</p>
              <p class="featureExample">{feature.example}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="how-title" class="band bandInk onDark" id="how-it-works">
    <div class="container">
      <div class="bandIntro">
        <p class="eyebrow eyebrowDot">A week in {productName}</p>
        <h2 class="title" id="how-title">
          Real work. <span class="serifAccent">A place for each part.</span>
        </h2>
        <p class="lead workflowLead">
          Start with the work on your desk today. The rest is there when you need it.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step">
              <div class="stepHead">
                <span class="stepNumber">{String(index + 1).padStart(2, "0")}</span>
                <Icon class="stepIcon" name={step.icon} size={20} />
              </div>
              <h3 class="stepTitle">{step.title}</h3>
              <p class="stepText">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="essentials-title" class="band">
    <div class="container">
      <div class="bandIntro">
        <p class="eyebrow eyebrowDot">The details matter, too</p>
        <h2 class="title" id="essentials-title">
          Keep the records. <span class="serifAccent">Control the access.</span>
        </h2>
      </div>
      <ul class="essentials">
        {
          essentials.map((item) => (
            <li class="essential">
              <Icon name={item.icon} size={24} />
              <h3 class="featureTitle">{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="pricing-title" class="band bandSunken" id="pricing">
    <div class="container">
      <div class="bandIntro bandIntroCenter">
        <p class="eyebrow eyebrowDot">Pricing</p>
        <h2 class="title" id="pricing-title">
          Start on your own. <span class="serifAccent">Grow with your team.</span>
        </h2>
      </div>
      <div class="pricingGrid">
        {
          plans.map((plan) => (
            <article
              class:list={["card", "priceCard", { cardAccent: plan.id === "pro" }]}
            >
              <div class="priceCardHead">
                <h3 class="priceName">{plan.name}</h3>
                <p class="priceDescription">{plan.description}</p>
              </div>
              <p class="price">
                <span class="priceAmount">{plan.price}</span>
                <span class="priceCadence">{plan.cadence}</span>
              </p>
              <ul class="priceFeatures">
                {plan.features.map((feature) => (
                  <li>
                    <Icon name="check" size={16} />
                    {feature}
                  </li>
                ))}
              </ul>
              <a
                class:list={[
                  "button",
                  "buttonLg",
                  "buttonBlock",
                  { buttonPrimary: plan.id === "pro" },
                ]}
                href={appUrl}
              >
                {plan.id === "pro" ? "Get started" : "Start free"}
              </a>
            </article>
          ))
        }
      </div>
      <p class="pricingNote">
        Pro is billed per active user each month, and seats stay in sync with
        your team. Checkout and billing management run through Stripe.
      </p>
    </div>
  </section>

  <section aria-labelledby="closing-title" class="band">
    <div class="container">
      <div class="closingPanel">
        <p class="eyebrow eyebrowDot">Your business, organized</p>
        <h2 class="title" id="closing-title">Put your next workday in order.</h2>
        <p class="lead closingLead">
          Create your free workspace. Upload a document, add your equipment, or
          connect a bank account. Upgrade to Pro when you’re ready to add your team.
        </p>
        <div class="cluster closingActions">
          <a class="button buttonPrimary buttonLg" href={appUrl}>
            Start free <Icon name="arrowRight" />
          </a>
          <a class="button buttonLg" href="#pricing">Compare plans</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
