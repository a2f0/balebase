---
/*
 * The document shell every page shares: head metadata, the skip link, the
 * site header and footer, and <main>.
 */
import "@balebase/ui/styles.css";
import "../styles/global.css";
import { releaseTier } from "@balebase/diagnostics/config";
import { productName } from "@balebase/ui/brand";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { canonicalUrl, robotsMeta, scriptJson, socialImage } from "../search";

interface Props {
  description: string;
  /**
   * False for a page kept out of search, such as the 404 page, which has no
   * URL of its own: it gets a robots noindex and no canonical or og:url.
   */
  indexed?: boolean;
  /** JSON-LD for the page, rendered as one application/ld+json script. */
  structuredData?: unknown;
  title: string;
}

const { description, indexed = true, structuredData, title } = Astro.props;
const robots = robotsMeta(
  releaseTier("PUBLIC_RELEASE_TIER", import.meta.env.PUBLIC_RELEASE_TIER),
  indexed,
);
// Only an indexed page names a canonical URL; a noindex page naming one
// would send crawlers conflicting signals.
const url = robots === null ? canonicalUrl(Astro.url.pathname) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {url && <link rel="canonical" href={url} />}
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#f5f4ef" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={productName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:image" content={socialImage.url} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={`${productName} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      structuredData !== undefined && (
        <script
          is:inline
          type="application/ld+json"
          set:html={scriptJson(structuredData)}
        />
      )
    }
  </head>
  <body>
    <a class="button buttonPrimary skipLink" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initClickTracking } from "@balebase/diagnostics/clickTracking";

      const pages = new Set(["/", "/privacy", "/terms", "/data-retention"]);

      initClickTracking({
        app: "website",
        origins: {
          production: "https://balebase.com",
          staging: "https://website-staging.balebase.com",
        },
        page: () => {
          const path = window.location.pathname.replace(/\/$/, "") || "/";
          return pages.has(path) ? path : "/other";
        },
      });
    </script>
  </body>
</html>
