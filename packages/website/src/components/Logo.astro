---
/* The brand lockup, matching the client's React <Logo>. */
import { productName } from "@balebase/ui/brand";
import BrandMark from "@balebase/ui/logo.svg";
---

<a
  aria-label={`${productName} home`}
  class="brand siteBrand"
  href="/"
>
  <BrandMark aria-hidden="true" class="brandMark" />
  <span>{productName}</span>
</a>
