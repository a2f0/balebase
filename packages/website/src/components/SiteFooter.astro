---
import { legalLinks, productName } from "@balebase/ui/brand";
import { appUrl, siteSections } from "../site";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="siteFooter onDark">
  <div class="container siteFooterInner">
    <div class="siteFooterBrand">
      <Logo />
      <p class="siteFooterTagline">
        Small business management software for your finances, people, contracts,
        and everyday operations.
      </p>
    </div>
    <nav aria-labelledby="footer-product" class="siteFooterNav">
      <p class="siteFooterHeading" id="footer-product">Explore</p>
      <ul class="siteFooterLinks">
        {
          siteSections.map((section) => (
            <li>
              <a href={section.href}>{section.label}</a>
            </li>
          ))
        }
        <li><a href={appUrl}>Sign in</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-legal" class="siteFooterNav">
      <p class="siteFooterHeading" id="footer-legal">Legal</p>
      <ul class="siteFooterLinks">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="container">
    <p class="siteFooterBase">© {year} {productName}, LLC</p>
  </div>
</footer>
