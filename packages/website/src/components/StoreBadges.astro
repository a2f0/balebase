---
/*
 * The App Store and Google Play badges. Each links to its listing once the
 * store has approved the app (`listed` in site.ts).
 * Keep the publishers' vector artwork intact:
 * https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg
 * https://partnermarketinghub.withgoogle.com/brands/google-play/google-play/lockups-icons-badges/?folder=86718
 * Google asset: GetItOnGooglePlay_Badge_Web_color_English.svg
 */
import { storeBadgeHref, storeListings } from "../site";
---

<div class="storeBadges">
  <ul class="cluster storeBadgeList">
    {
      storeListings.map((listing) => {
        const href = storeBadgeHref(listing);
        const image = (
          <img
            alt={listing.label}
            height={listing.badge.height}
            src={listing.badge.src}
            width={listing.badge.width}
          />
        );
        return (
          <li data-store={listing.id}>
            {href === null ? (
              <span class="storeBadge">{image}</span>
            ) : (
              <a class="storeBadge" href={href}>
                {image}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</div>
