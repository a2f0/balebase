[Unit]
Description=Balebase inbound SMTP receiver
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
StateDirectory=balebase-smtp
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/balebase-smtp/receiver.env
LoadCredential=bridge-token:/etc/balebase-smtp/bridge-token
LoadCredential=fullchain.pem:/etc/balebase-smtp/fullchain.pem
LoadCredential=privkey.pem:/etc/balebase-smtp/privkey.pem
ExecStart=/opt/balebase-smtp/venv/bin/python -B /opt/balebase-smtp/receiver.py
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=512
MemoryMax=1G

[Install]
WantedBy=multi-user.target
