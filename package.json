{
  "name": "balebase",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "agent-tool": "agent-tool",
    "agent:logs": "bunx --bun --no-install agent-tool logs",
    "agent:run": "bunx --bun --no-install agent-tool run",
    "agents:check": "bun run agent-tool skills check",
    "agents:sync": "bun run agent-tool skills install --apply",
    "auth:set-role": "bash scripts/admin/setUserRole.sh",
    "build": "bunx --bun --no-install turbo run build",
    "check": "OPENSSL_CONF=/dev/null agent-tool run-group scripts/testing/check.json",
    "check:fast": "OPENSSL_CONF=/dev/null agent-tool run-group scripts/testing/checkFast.json",
    "check:scripts": "bunx --bun --no-install tsc --noEmit --project scripts/tsconfig.json",
    "deploy": "bash scripts/deploy/deployProduction.sh",
    "deploy:api": "bash scripts/deploy/deployApi.sh",
    "deploy:app": "bash scripts/deploy/deployApp.sh",
    "deploy:domains": "bash scripts/deploy/configureProductionDomains.sh",
    "deploy:email:verify": "bash scripts/deploy/verifyInboundEmail.sh",
    "deploy:staging": "bash scripts/deploy/deployStaging.sh",
    "deploy:staging:frontends": "bash scripts/deploy/deployStagingFrontends.sh",
    "deploy:verify": "bash scripts/deploy/verifyProduction.sh",
    "deploy:website": "bash scripts/deploy/deployWebsite.sh",
    "dev": "bunx --bun --no-install turbo run dev",
    "emails:purge": "bash scripts/admin/purgeEmails.sh",
    "format": "bun --bun run lint:biome:fix && bun --bun run lint:markdown:fix",
    "hooks:check": "agent-tool hooks check",
    "hooks:install": "agent-tool hooks install --apply",
    "images": "agent-tool images build native && agent-tool images build favicons --out packages/ui/dist/images/web",
    "install:dependencies": "bun --bun run bun install",
    "lint": "agent-tool run-group scripts/testing/lint.json",
    "lint:binary-files": "agent-tool checks binaries",
    "lint:biome": "bunx --bun --no-install biome check --error-on-warnings .",
    "lint:biome:fix": "bunx --bun --no-install biome check --write --error-on-warnings .",
    "lint:branch-name": "agent-tool branch check",
    "lint:commit-msg": "bunx --bun --no-install commitlint --config commitlint.config.mts --edit",
    "lint:files": "bunx --bun --no-install ls-lint",
    "lint:knip:all": "bunx --bun --no-install knip",
    "lint:knip:dependencies": "bunx --bun --no-install knip --dependencies",
    "lint:knip:exports": "bunx --bun --no-install knip --exports",
    "lint:knip:files": "bunx --bun --no-install knip --files",
    "lint:knip:production": "bunx --bun --no-install knip --production",
    "lint:markdown": "bun --bun x markdownlint-cli2 '**/*.md'",
    "lint:markdown:fix": "bun --bun x markdownlint-cli2 --fix '**/*.md'",
    "lint:rubocop": "bun run --cwd packages/app-capacitor lint:rubocop",
    "lint:scripts": "shellcheck scripts/admin/*.sh scripts/checks/*.sh scripts/deploy/*.sh scripts/dev/*.sh scripts/git/hooks/* scripts/lib/*.sh scripts/release/*.sh scripts/testing/*.sh skills/*/scripts/*.sh terraform/scripts/*.sh",
    "lint:staged": "bunx --bun --no-install lint-staged",
    "lint:terraform": "bash scripts/checks/checkTerraform.sh",
    "mobile:android": "bun run mobile:sync && bun run --cwd packages/app-capacitor cap:open:android",
    "mobile:build:android": "sh scripts/release/buildAndroidRelease.sh",
    "mobile:build:android:staging": "sh scripts/release/buildAndroidStagingRelease.sh",
    "mobile:build:ios": "sh scripts/release/buildIosRelease.sh",
    "mobile:build:ios:staging": "sh scripts/release/buildIosStagingRelease.sh",
    "mobile:ios": "bun run mobile:sync && bun run --cwd packages/app-capacitor cap:open:ios",
    "mobile:run:android": "sh scripts/dev/runAndroid.sh",
    "mobile:run:ios": "sh scripts/dev/runIos.sh",
    "mobile:sync": "bun run --cwd packages/app-capacitor build && bun run --cwd packages/app-capacitor cap:sync",
    "mobile:upload:android": "sh scripts/release/uploadAndroidRelease.sh",
    "mobile:upload:android:staging": "sh scripts/release/uploadAndroidStagingRelease.sh",
    "mobile:upload:ios": "sh scripts/release/uploadIosRelease.sh",
    "mobile:upload:ios:staging": "sh scripts/release/uploadIosStagingRelease.sh",
    "organizations:objects:reorganize": "bash scripts/admin/reorganizeOrganizationObjects.sh",
    "organizations:purge": "bash scripts/admin/purgeOrganizations.sh",
    "scope": "bash scripts/dev/scope.sh",
    "scope:benchmark": "bash scripts/dev/scope.sh benchmark",
    "scope:down": "bash scripts/dev/scope.sh down",
    "scope:install": "bash scripts/dev/scope.sh install",
    "scope:judge": "bash scripts/dev/scope.sh judge",
    "scope:register": "bash scripts/dev/scope.sh register",
    "scope:status": "bash scripts/dev/scope.sh status",
    "scope:up": "bash scripts/dev/scope.sh up",
    "terraform:apply": "bash terraform/scripts/run.sh apply",
    "terraform:plan": "bash terraform/scripts/run.sh plan",
    "terraform:staging:apply": "bash terraform/scripts/run.sh staging apply",
    "terraform:staging:plan": "bash terraform/scripts/run.sh staging plan",
    "terraform:validate": "bash terraform/scripts/run.sh validate",
    "test": "OPENSSL_CONF=/dev/null agent-tool run-group scripts/testing/test.json",
    "test:env": "bash scripts/testing/testCloudflareEnv.sh",
    "test:hooks": "bun test scripts/testing/prePush.test.ts",
    "test:images": "bun test scripts/testing/brandImages.test.ts",
    "test:markdownlint": "bun test scripts/testing/markdownlintConfig.test.ts",
    "test:scope": "bun test scripts/testing/scope.test.ts scripts/dev/scope",
    "test:sentry": "bun test scripts/testing/sentryRelease.test.ts scripts/testing/sentryOrchestration.test.ts",
    "test:seo-probe": "bun test scripts/testing/seoProbe.test.ts",
    "test:staging": "bash scripts/testing/testDeployStaging.sh && bun test scripts/testing/stagingFrontends.test.ts",
    "verify": "OPENSSL_CONF=/dev/null agent-tool run-group scripts/testing/verify.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "*.{astro,css,html,js,json,jsonc,jsx,mjs,cjs,ts,tsx}": "bunx --bun --no-install biome check --fix --error-on-warnings",
    "*.md": "bun --bun x markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.20",
    "@azure/storage-blob": "12.30.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@ls-lint/ls-lint": "2.3.2",
    "@sentry/cli": "3.8.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "tar": "7.5.16",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "wrangler": "4.151.1",
    "zod": "4.6.7"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "markdownlint-cli2@0.23.3": {
      "smol-toml": "1.9.1"
    },
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  },
  "patchedDependencies": {
    "markdownlint@0.41.1": "patches/markdownlint@0.41.1.patch"
  }
}
