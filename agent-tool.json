{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 50,
    "types": [
      "build",
      "chore",
      "ci",
      "cleanup",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ]
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "Check, test, and build",
        "workflow": "CI"
      }
    ],
    "requireStrictBaseFreshness": true
  },
  "versions": {
    "packages": [
      "packages/api",
      "packages/app",
      "packages/app-capacitor",
      "packages/app-web"
    ]
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "permissions": {
    "executables": {
      "wrangler": "release"
    }
  },
  "images": {
    "targets": {
      "favicons": {
        "outputs": [
          {
            "path": "favicon.svg",
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "layers": [
              {
                "source": "logo",
                "pixelSnap": true
              }
            ]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              {
                "fill": "#b7ff5b"
              },
              {
                "source": "logo",
                "scale": 0.8,
                "pixelSnap": true
              }
            ]
          }
        ]
      },
      "social": {
        "outputs": [
          {
            "path": "og-image.png",
            "size": [1200, 630],
            "opaque": true,
            "layers": [
              {
                "fill": "#181916"
              },
              {
                "source": "logo",
                "scale": 0.5,
                "pixelSnap": true
              }
            ]
          }
        ]
      },
      "native": {
        "dir": "packages/ui/dist/images",
        "outputs": [
          {
            "path": "ios/App/App/Assets.xcassets/AppIcon.appiconset/AppIcon-512@2x.png",
            "size": 1024,
            "opaque": true,
            "layers": [
              {
                "fill": "#b7ff5b"
              },
              {
                "source": "logo",
                "scale": 0.75,
                "pixelSnap": true
              }
            ]
          },
          {
            "path": "ios/App/App/Assets.xcassets/Splash.imageset/splash{variant}.png",
            "size": 2732,
            "variants": {
              "": 1,
              "@2x": 1,
              "@3x": 1
            },
            "opaque": true,
            "layers": [
              {
                "fill": "#181916"
              },
              {
                "source": "logo",
                "scale": 0.2,
                "pixelSnap": true
              }
            ]
          },
          {
            "path": "android/app/src/main/res/values/ic_launcher_background.xml",
            "colors": {
              "ic_launcher_background": "#b7ff5b"
            }
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher.png",
            "size": 48,
            "variants": "android",
            "opaque": true,
            "layers": [
              {
                "fill": "#b7ff5b"
              },
              {
                "source": "logo",
                "scale": 0.7,
                "pixelSnap": true
              }
            ]
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher_round.png",
            "size": 48,
            "variants": "android",
            "opaque": true,
            "layers": [
              {
                "fill": "#b7ff5b"
              },
              {
                "source": "logo",
                "scale": 0.5,
                "pixelSnap": true
              }
            ]
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher_foreground.png",
            "size": 108,
            "variants": "android",
            "layers": [
              {
                "source": "logo",
                "scale": 0.6,
                "pixelSnap": true
              }
            ]
          },
          {
            "path": "android/app/src/main/res/drawable-{variant}/splash.png",
            "variants": {
              "mdpi": [320, 480],
              "land-mdpi": [480, 320],
              "land-hdpi": [800, 480],
              "land-xhdpi": [1280, 720],
              "land-xxhdpi": [1600, 960],
              "land-xxxhdpi": [1920, 1280],
              "port-mdpi": [320, 480],
              "port-hdpi": [480, 800],
              "port-xhdpi": [720, 1280],
              "port-xxhdpi": [960, 1600],
              "port-xxxhdpi": [1280, 1920]
            },
            "opaque": true,
            "layers": [
              {
                "fill": "#181916"
              },
              {
                "source": "logo",
                "scale": 0.3,
                "pixelSnap": true
              }
            ]
          },
          {
            "path": "plaid/icon-1024.png",
            "size": 1024,
            "opaque": true,
            "layers": [
              {
                "fill": "#b7ff5b"
              },
              {
                "source": "logo",
                "scale": 0.75,
                "pixelSnap": true
              }
            ]
          }
        ]
      }
    }
  },
  "branch": {
    "types": [
      "build",
      "chore",
      "ci",
      "cleanup",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ],
    "exempt": ["main"],
    "maxLength": null
  },
  "commits": {
    "signatures": "present",
    "signatureHeaderFallback": false,
    "rejectCoauthors": true,
    "subjects": false
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-commit",
        "target": "pre-commit",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  },
  "screenshots": {
    "source": ".screenshots",
    "targets": {
      "website": {
        "dir": "packages/website/public/screenshot-gallery",
        "urlPrefix": "/screenshot-gallery/",
        "projects": {
          "web": {
            "label": "Desktop",
            "frame": "none"
          },
          "ipad": {
            "label": "Tablet",
            "frame": "tablet"
          },
          "mobile": {
            "label": "Phone",
            "frame": "phone"
          }
        },
        "themes": ["light", "dark"],
        "screens": [
          {
            "name": "projects",
            "label": "Projects",
            "alt": "Projects: the Harborline Electric job list with each project's crew and audit forms."
          },
          {
            "name": "issues",
            "label": "Issues",
            "alt": "Issues: open and resolved work items with priority, assignee, and where each was raised."
          },
          {
            "name": "audits",
            "label": "Audits",
            "alt": "Audits: in-progress and completed safety audits started from the NFPA 70E and residential checklists."
          },
          {
            "name": "audit",
            "label": "Audit",
            "alt": "An NFPA 70E audit in progress, showing the issues it raised with their site photos."
          },
          {
            "name": "equipment",
            "label": "Equipment",
            "alt": "Equipment: company laptops, phones, and a monitor with serial numbers, purchase dates, and assignees."
          },
          {
            "name": "businesses",
            "label": "Businesses",
            "alt": "Businesses: the company's legal entities with EINs, addresses, and incorporation dates."
          },
          {
            "name": "contracts",
            "label": "Contracts",
            "alt": "Contracts: completed, sent, and draft agreements with their signing status."
          },
          {
            "name": "contract",
            "label": "Contract",
            "alt": "A contract out for signature, with each signer's status in routing order."
          },
          {
            "name": "finance",
            "label": "Finance",
            "alt": "Finance: bank and card balances above categorized, reviewed transactions."
          },
          {
            "name": "library",
            "label": "Library",
            "alt": "Library: shared document folders for safety, insurance, and fleet records."
          },
          {
            "name": "activity",
            "label": "Activity",
            "alt": "Activity: who changed what and when across the organization."
          },
          {
            "name": "organization",
            "label": "People",
            "alt": "People: the organization's members with their roles."
          },
          {
            "name": "groups",
            "label": "Groups",
            "alt": "Groups: the Admins, Finance, and Field crew groups and what each can do."
          }
        ]
      }
    }
  }
}
