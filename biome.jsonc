{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Select"]
          }
        }
      },
      "complexity": {
        "useLiteralKeys": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 75,
            "skipBlankLines": true,
            "skipIifes": true
          }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@balebase/api": "Do not import from the API Worker package",
              "@balebase/app-capacitor": "Do not import from the native app shell",
              "@balebase/app-web": "Do not import from the web app shell",
              "@balebase/website": "Do not import from the website deployment target"
            }
          }
        }
      }
    }
  },
  "overrides": [
    // Keep application modules navigable without counting whitespace against them.
    {
      "includes": [
        "packages/api/src/**/*.ts",
        "packages/app/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 800,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    // Existing large files may shrink, but should not grow. Remove an override
    // once its file fits the default budget; extract responsibilities to get there.
    {
      "includes": ["packages/api/src/auditIssueImages.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 864,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/api/src/billing.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 2117,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/api/src/employeeForms.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 842,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/api/src/residentialAuditLibrary.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 3135,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/app/src/AuditRunPage.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 1202,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/app/src/Businesses.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 819,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/app/src/**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/website/src/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
