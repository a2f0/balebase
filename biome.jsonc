{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Select"]
          }
        }
      },
      "complexity": {
        "useLiteralKeys": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 75,
            "skipBlankLines": true,
            "skipIifes": true
          }
        }
      },
      "suspicious": {
        "noImportCycles": {
          "level": "error",
          "options": { "ignoreTypes": false }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@balebase/api": "Do not import from the API Worker package",
              "@balebase/app-capacitor": "Do not import from the native app shell",
              "@balebase/app-web": "Do not import from the web app shell",
              "@balebase/website": "Do not import from the website deployment target"
            }
          }
        }
      }
    }
  },
  "overrides": [
    // Keep application modules navigable without counting whitespace against them.
    {
      "includes": [
        "packages/api/src/**/*.ts",
        "packages/app/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 800,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    // API shared modules stay below features: they import only Worker types.
    {
      "includes": [
        "packages/api/src/shared/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // Overrides replace rule options, so repeat the root paths.
                "paths": {
                  "@balebase/api": "Do not import from the API Worker package",
                  "@balebase/app-capacitor": "Do not import from the native app shell",
                  "@balebase/app-web": "Do not import from the web app shell",
                  "@balebase/website": "Do not import from the website deployment target"
                },
                "patterns": [
                  {
                    "group": ["../**", "!../types", "!../auth/apiEnv"],
                    "message": "shared/ sits below the features; move this code into the feature that owns it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // App shared modules stay below features: they import only the host interface.
    {
      "includes": [
        "packages/app/src/shared/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // Overrides replace rule options, so repeat the root paths.
                "paths": {
                  "@balebase/api": "Do not import from the API Worker package",
                  "@balebase/app-capacitor": "Do not import from the native app shell",
                  "@balebase/app-web": "Do not import from the web app shell",
                  "@balebase/website": "Do not import from the website deployment target"
                },
                "patterns": [
                  {
                    "group": ["../**", "!../host", "!../apiVersion"],
                    "message": "shared/ sits below the features; move this code into the feature that owns it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // App components get a lower cognitive complexity limit than other source.
    {
      "includes": ["packages/app/src/**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/website/src/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
