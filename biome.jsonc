{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  // Markdownlint owns Markdown formatting; preserve the pre-2.6 scope.
  "markdown": {
    "formatter": { "enabled": false }
  },
  "linter": {
    "enabled": true,
    // Biome does not detect bun:test, so opt in to its test rules.
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Select"]
          }
        }
      },
      "complexity": {
        "useLiteralKeys": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 75,
            "skipBlankLines": true,
            "skipIifes": true
          }
        }
      },
      "correctness": {
        "noNestedComponentDefinitions": "error",
        "noReactPropAssignments": "error",
        "noUnusedInstantiation": "error"
      },
      // Bug-catching rules not yet stable. When a Biome upgrade promotes one,
      // move it to the group the upgrade reports.
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noBaseToString": "error",
        "noBooleanSortComparator": "error",
        "noDuplicateMapKeys": "error",
        "noExtendNative": "error",
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noInvalidThis": "error",
        "noNegationInEqualityCheck": "error",
        "noReturnInFinally": "error",
        "noUnsafePlusOperands": "error",
        "noUselessAssignment": "error",
        "noXorAsExponentiation": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "suspicious": {
        "noConstantBinaryExpressions": "error",
        "noImportCycles": {
          "level": "error",
          "options": { "ignoreTypes": false }
        },
        "noJsxLeakedDollar": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noSkippedTests": "error",
        "noUnassignedVariables": "error",
        "noUnknownAttribute": "error",
        "noUnusedExpressions": "error"
      },
      "style": {
        "useThrowOnlyError": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@balebase/api": "Do not import from the API Worker package",
              "@balebase/app-capacitor": "Do not import from the native app shell",
              "@balebase/app-web": "Do not import from the web app shell",
              "@balebase/website": "Do not import from the website deployment target",
              "@balebase/client-sdk/testing": "Test fixtures only: its raw offline writes skip the form state machine and the sync queue"
            }
          }
        }
      }
    }
  },
  "overrides": [
    // Keep application modules navigable without counting whitespace against them.
    {
      "includes": [
        "packages/api/src/**/*.ts",
        "packages/app/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 800,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    // API shared modules stay below features: they import only Worker types.
    {
      "includes": [
        "packages/api/src/shared/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // Overrides replace rule options, so repeat the root paths.
                "paths": {
                  "@balebase/api": "Do not import from the API Worker package",
                  "@balebase/app-capacitor": "Do not import from the native app shell",
                  "@balebase/app-web": "Do not import from the web app shell",
                  "@balebase/website": "Do not import from the website deployment target",
                  "@balebase/client-sdk/testing": "Test fixtures only: its raw offline writes skip the form state machine and the sync queue"
                },
                "patterns": [
                  {
                    "group": ["../**", "!../types", "!../auth/apiEnv"],
                    "message": "shared/ sits below the features; move this code into the feature that owns it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // App shared modules stay below features: they import only the host interface
    // and the app's SDK.
    {
      "includes": [
        "packages/app/src/shared/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // Overrides replace rule options, so repeat the root paths.
                "paths": {
                  "@balebase/api": "Do not import from the API Worker package",
                  "@balebase/app-capacitor": "Do not import from the native app shell",
                  "@balebase/app-web": "Do not import from the web app shell",
                  "@balebase/website": "Do not import from the website deployment target",
                  "@balebase/client-sdk/testing": "Test fixtures only: its raw offline writes skip the form state machine and the sync queue"
                },
                "patterns": [
                  {
                    "group": ["../**", "!../host", "!../balebase"],
                    "message": "shared/ sits below the features; move this code into the feature that owns it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // App components get a lower cognitive complexity limit than other source.
    {
      "includes": ["packages/app/src/**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/website/src/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    // Tests and the app's browser fixtures may seed a device through the
    // SDK's fixtures-only entry; nothing else may. The shells' browser
    // fixtures (app-web, app-capacitor) test their platform code and never
    // seed a device, so this is app-only on purpose: add a shell's own path,
    // such as packages/app-web/browser/**, only for a fixture that must.
    {
      "includes": ["packages/app/browser/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // Overrides replace rule options, so repeat the root paths.
                "paths": {
                  "@balebase/api": "Do not import from the API Worker package",
                  "@balebase/app-capacitor": "Do not import from the native app shell",
                  "@balebase/app-web": "Do not import from the web app shell",
                  "@balebase/website": "Do not import from the website deployment target"
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
