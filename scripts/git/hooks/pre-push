#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# A copied hook must match the checked-out version before it can gate a push.
if ! cmp -s "$0" "$REPO_ROOT/scripts/git/hooks/pre-push"; then
  echo "Error: pre-push hook is stale. Run bun run hooks:install." >&2
  exit 1
fi

cd "$REPO_ROOT"

bun run hooks:check </dev/null

push_remote=${1:-origin}
zero_sha="0000000000000000000000000000000000000000"

# Git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# pushed ref on stdin.
pushed_refs=""
if [ ! -t 0 ]; then
  pushed_refs=$(cat)
fi

printf '%s\n' "$pushed_refs" | bun run lint:branch-name --pre-push

# Cheapest gate first: every pushed commit must be signed and carry no
# Co-authored-by trailer. Deletions push no commits and are skipped. Checking
# everything the remote's refs do not already reach, rather than everything
# after local main, keeps unsigned work committed on local main from riding
# along on a new branch.
echo "Checking commit signatures and co-authors..."
while read -r _ local_sha _ remote_sha; do
  if [ -z "$local_sha" ] || [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  set -- --range "$local_sha"
  if [ "$remote_sha" != "$zero_sha" ]; then
    set -- "$@" --exclude "$remote_sha"
  fi
  if git remote get-url "$push_remote" >/dev/null 2>&1; then
    set -- "$@" --exclude-remotes "$push_remote"
  fi
  bun run agent-tool commits check "$@" </dev/null
done <<REFS
$pushed_refs
REFS

echo "Running repository checks..."
bun --bun run check

echo "Running tests..."
bun --bun run test

echo "All checks passed."
