{
  // Keep globs in package scripts so lint-staged only checks staged Markdown.
  "gitignore": true,
  "ignores": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.astro/**",
    "**/.wrangler/**",
    "**/dist/**",
    // agent-tool manages these skills; bun run agents:check verifies them.
    ".agents/skills/**",
    ".claude/skills/**"
  ],
  "config": {
    "default": true,
    "MD013": {
      "code_blocks": false,
      "tables": false
    }
  }
}
